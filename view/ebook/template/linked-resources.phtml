<?php
/**
 * @var \Laminas\View\Renderer\PhpRenderer $this
 * @var \Omeka\Api\Representation\AbstractResourceEntityRepresentation $resource
 *
 * The core partial "common/linked-resources" is not used: it requires a
 * request (pagination, filters), unavailable in a job.
 */

$subjectValues = $resource->subjectValues();
if (!$subjectValues) return;

$translate = $this->plugin('translate');
$escape = $this->plugin('escapeHtml');
?>

<div id="item-linked">
    <h3><?= $translate('Linked resources') ?></h3>
    <?php foreach ($subjectValues as $label => $results): ?>
    <div class="property">
        <h4><?= $escape($translate($label)) ?></h4>
        <div class="values">
            <?php foreach ($results as $result): ?>
            <div class="value resource"><?= $escape($result['val']->resource()->displayTitle()) ?></div>
            <?php endforeach; ?>
        </div>
    </div>
    <?php endforeach; ?>
</div>
