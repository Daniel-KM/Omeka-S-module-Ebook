{
    "name": "daniel-km/omeka-s-module-ebook",
    "type": "omeka-s-module",
    "description": "Module for Omeka S: Merge selected resources into an ePub or a pdf file for publishing, report, or archiving purpose.",
    "keywords": [
        "Omeka S",
        "Omeka S module",
        "export",
        "ebook",
        "ePub",
        "pdf",
        "publishing",
        "report",
        "archiving"
    ],
    "license": "CECILL-2.1",
    "homepage": "https://gitlab.com/Daniel-KM/Omeka-S-module-Ebook",
    "authors": [
        {
            "name": "Daniel Berthereau",
            "email": "Daniel.packagist@Berthereau.net"
        }
    ],
    "support": {
        "issues": "https://gitlab.com/Daniel-KM/Omeka-S-module-Ebook/-/work_items",
        "forum": "https://forum.omeka.org/"
    },
    "_require (not set until Omeka S merges PR #2432)": {
        "omeka/omeka-s": "^4.0",
        "daniel-km/omeka-s-module-common": "*"
    },
    "require": {
        "futurepress/epubjs-reader": "0.3",
        "gmo/iso-639": "^1.0",
        "grandt/phpepub": "dev-master",
        "vanilla/htmlawed": "~1.0"
    },
    "repositories": [
        {
            "type": "git",
            "url": "https://gitlab.com/Daniel-KM/PHPePub"
        },
        {
            "type": "package",
            "package": {
                "name": "futurepress/epubjs-reader",
                "version": "0.3",
                "type": "omeka-module-asset",
                "dist": {
                    "type": "zip",
                    "url": "https://github.com/futurepress/epubjs-reader/archive/refs/heads/master.zip"
                }
            }
        }
    ],
    "autoload": {
        "psr-4": {
            "Ebook\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "EbookTest\\": "tests/EbookTest/"
        }
    },
    "scripts": {
        "post-install-cmd": "@build",
        "post-update-cmd": "@build",
        "build": [
            "mv asset/vendor/epubjs-reader/reader asset/vendor/reader",
            "rm -rf asset/vendor/epubjs-reader",
            "mv asset/vendor/reader asset/vendor/epubjs-reader"
        ]
    },
    "extra": {
        "installer-name": "Ebook"
    }
}
